# Скопируйте этот файл в .env:  cp .env.example .env
# Файл .env в git не попадает - так и должно быть.
# Значения пишем без кавычек и без пробелов вокруг знака "=".

# По умолчанию - публичный ClickHouse с открытыми датасетами (доступ только на чтение).
# Ничего регистрировать и создавать не нужно, датасет такси Нью-Йорка уже там.
CLICKHOUSE_HOST=sql-clickhouse.clickhouse.com
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=demo
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# Если хотите работать со своим сервисом ClickHouse Cloud (тем, что заводили
# на SQL-модуле) - впишите его доступы вместо публичных. Где их взять:
# сервис в clickhouse.cloud -> Connect -> вкладка HTTPS.
# Код при этом менять не нужно, src/db.py читает всё отсюда.
